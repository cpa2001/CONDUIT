# Example environment for reproducing CONDUIT.
#
#   cp .env.example .env    # then edit as needed
#   set -a && . ./.env && set +a
#
# Everything here is optional: left unset, every path falls back to a location
# inside the repository. You only need these when the weights or data live
# somewhere else.

# ---------------------------------------------------------------------------
# Model weights
# ---------------------------------------------------------------------------
# Defaults to <repo root>/models/, organised by model directory name:
#   models/internvl3-9b/
#   models/qwen2.5-vl-3b-instruct/
#   models/qwen2.5-vl-7b-instruct/
# Set this when the weights live elsewhere (point it at the parent directory
# that contains those three):
# export CONDUIT_MODELS_DIR=/path/to/models

# Per-model overrides, which take precedence over CONDUIT_MODELS_DIR:
# export NANOVLLM_INTERNVL3_9B_MODEL_PATH=/path/to/internvl3-9b
# export NANOVLLM_QWEN25VL_3B_MODEL_PATH=/path/to/qwen2.5-vl-3b-instruct
# export NANOVLLM_QWEN25VL_7B_MODEL_PATH=/path/to/qwen2.5-vl-7b-instruct

# ---------------------------------------------------------------------------
# MMLongBench data
# ---------------------------------------------------------------------------
# Lives at benchmark/MMLongBench/{mmlb_data,mmlb_image}. See
# benchmark/MMLongBench/scripts/download_{text,image}_data.sh for how to obtain
# it.
#
# There is no environment variable for this: the scripts pass
# ${BENCHMARK_ROOT}/mmlb_data and ${BENCHMARK_ROOT}/mmlb_image directly. To keep
# the data elsewhere, symlink it into place:
#
#   ln -s /path/to/mmlb_data  benchmark/MMLongBench/mmlb_data
#   ln -s /path/to/mmlb_image benchmark/MMLongBench/mmlb_image
